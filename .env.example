NODE_ENV=development
PORT=5000
API_BASE_PATH=/api/v1
WEB_ORIGIN=http://localhost:3000
# Public API origin only (no /api/v1 suffix). Required in production to build trusted image URLs.
PUBLIC_API_URL=http://localhost:5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/sm_associate_cars?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30
