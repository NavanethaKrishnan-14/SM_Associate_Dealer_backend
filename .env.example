NODE_ENV=development
PORT=5000
API_BASE_PATH=/api/v1
# Comma-separated web origins allowed to call this API from browsers.
# Add the exact deployed website origin here; React Native requests need no Origin allowlist entry.
WEB_ORIGIN=http://localhost:3000
# Public API origin only (no /api/v1 suffix). Required in production to build trusted image URLs.
PUBLIC_API_URL=http://localhost:5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/sm_associate_cars?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30

# One-time initial Admin seed only (set these in your local shell, not production hosting).
# Use: npm run admin:seed
# ADMIN_NAME=Initial Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PHONE=9790219874
# ADMIN_PASSWORD=use-a-unique-password-at-least-12-characters
