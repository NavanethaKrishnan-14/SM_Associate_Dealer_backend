{
  "name": "sm-associate-cars-api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the SM Associate Cars marketplace",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "migrate:prefixed-ids": "tsx scripts/migrate-prefixed-ids.ts",
    "audit:object-ids": "tsx scripts/audit-object-ids.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "zod": "^4.6.5",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "express-rate-limit": "^8.1.0",
    "mongoose": "^9.11.1",
    "multer": "^2.0.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.30",
    "@types/multer": "^2.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/swagger-ui-express": "^4.1.8"
  }
}
