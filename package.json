{
  "name": "sm-associate-cars-api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the SM Associate Cars marketplace",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "zod": "^3.25.76",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "express-rate-limit": "^8.1.0",
    "mongoose": "^8.19.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.30",
    "@types/multer": "^2.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
